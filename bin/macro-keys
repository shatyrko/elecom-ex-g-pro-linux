#!/usr/bin/env python3
"""macro-keys - remaps a small macro device (keypad, dial, mouse, trackball) on Linux.

Each device has a description file (~/.local/share/macro-keys/devices/<id>.py) and its own app
(macro-keys-studio --device <id>) and service (this program, one per device). The service reads
the device's own input devices, takes them over (EVIOCGRAB: only those, never the real keyboard)
and turns every press into what is set for it: the original key, any shortcut, a desktop action,
an app, a command or typed text. Mice and trackballs: movement and scrolling pass straight
through a virtual mouse, unchanged buttons too (held for dragging). Per-app profiles: the focused
window's app_id (Umbriel compositor) picks a profile, falling back to "default".

No extra packages: raw evdev reading and a uinput virtual device through ioctl (the user is in
the `input` group and /dev/uinput is group-writable; see the udev rule of the repository).

  macro-keys --device <id>              run (one systemd user unit per device)
  macro-keys --test <id> <control>      ask that running service to run a control's action

Settings: ~/.config/macro-keys/<id>.json (reloaded when it changes). Live events for the app:
Unix socket $XDG_RUNTIME_DIR/macro-keys-<id>.sock, one JSON object per line.
"""
import fcntl, glob, json, os, re, select, socket, struct, subprocess, sys, time

CONF_DIR = os.path.expanduser("~/.config/macro-keys")


def conf_path(kind):
    return os.path.join(CONF_DIR, f"{kind}.json")


def sock_path(kind):
    return os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), f"macro-keys-{kind}.sock")
EVENT = struct.Struct("llHHi")
EV_SYN, EV_KEY, EV_REL = 0, 1, 2
REL_HWHEEL, REL_HWHEEL_HI_RES = 0x06, 0x0c
EVIOCGRAB = 0x40044590
UI_SET_EVBIT, UI_SET_KEYBIT, UI_SET_RELBIT = 0x40045564, 0x40045565, 0x40045566
UI_DEV_SETUP, UI_DEV_CREATE = 0x405C5503, 0x5501

# ------------------------------------------------------------------ the devices
# One description file per device (devices/<id>.py: DEVICE = {...}, plain data) in
# ~/.local/share/macro-keys/devices (or $MACRO_KEYS_DEVICES). Each device's repository installs
# its own file; this engine is the same for all of them.
DEVICE_DIR = os.environ.get("MACRO_KEYS_DEVICES") or os.path.expanduser("~/.local/share/macro-keys/devices")


def load_devices():
    import ast
    found = {}
    for f in sorted(glob.glob(os.path.join(DEVICE_DIR, "*.py"))):
        try:
            tree = ast.parse(open(f).read(), f)
            node = next(n.value for n in tree.body if isinstance(n, ast.Assign)
                        and any(getattr(t, "id", None) == "DEVICE" for t in n.targets))
            dev = ast.literal_eval(node)   # data only: a device file cannot run code
            found[dev["id"]] = dev
        except (OSError, SyntaxError, ValueError, StopIteration, KeyError) as e:
            print(f"device file {f}: {e}", file=sys.stderr)
    return found


DEVICES = load_devices()
# what a device sends, in words (shown in the app); generic names, then each device's own
SENDS = {"BTN_LEFT": "Left click", "BTN_RIGHT": "Right click", "BTN_MIDDLE": "Middle click (wheel)",
         "BTN_SIDE": "Back", "BTN_EXTRA": "Forward", "BTN_FORWARD": "Button 10", "BTN_BACK": "Button 11",
         "BTN_TASK": "Button 12", "REL_HWHEEL-": "Scroll left", "REL_HWHEEL+": "Scroll right",
         "KEY_VOLUMEUP": "Volume up", "KEY_VOLUMEDOWN": "Volume down", "KEY_MUTE": "Mute"}
for _d in DEVICES.values():
    SENDS.update(_d.get("sends", {}))

# desktop actions offered in the app: id -> (group, label, argv)
NM, UM = ["noctalia", "msg"], ["umbriel", "msg"]
ACTIONS = {
    "volume-up": ("Sound", "Volume up", NM + ["volume-up"]),
