[Unit]
Description=EX-G Pro trackball button remapping (~/.local/bin/macro-keys --device exgpro, settings: the EX-G Pro app)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/macro-keys --device exgpro
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
